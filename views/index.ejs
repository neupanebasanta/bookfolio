<!-- Header section -->
<%- include('partials/header.ejs') %>

    <!-- Main section -->
    <main class="books-page">

        <!-- Page header -->
        <div class="page-header">
            <h1>My Books</h1>
        </div>

        <!-- Books control panal -->
        <div class="books-controls">

            <!-- Search Bar Form -->
            <form action="/book" method="post" class="search-form">
                <input type="search" name="search_query" placeholder="Search books...">
                <button type="submit">Search</button>
            </form>

            <!-- Sort options Form -->
            <form action="/books" method="get" class="sort-form">
                <select name="sort_query" id="sort-menu">
                    <option value="recent">Recent</option>
                    <option value="rating">Rating</option>
                    <option value="a-z">A-Z</option>
                </select>
                <button type="submit">Sort</button>
            </form>
        </div>

        <!-- Books Grid -->
        <div class="books-grid">

            <!-- Book Card -->
            <% books.forEach(book=> { %>
                <article class="book-card">

                    <!-- Cover -->
                    <div class="book-card-cover">
                        <a href="/books/<%= book.id %>">
                            <% if (book.cover_url) { %>
                                <img src="<%= book.cover_url %>" alt="<%= book.title %>">
                                <% } else{ %>
                                    <div class="book-card-no-cover">
                                        No cover
                                    </div>
                                    <% } %>
                        </a>

                    </div>

                    <!-- Info -->
                    <div class="book-card-info">

                        <!-- Title -->
                        <a href="/books/<%= book.id %>" class="book-card-title">
                            <h2>
                                <%= book.title %>
                            </h2>
                        </a>

                        <!-- Author -->
                        <p class="book-card-author">
                            by <%= book.author %>
                        </p>

                        <!-- Rating and Status -->
                        <div class="book-card-meta">
                            <!-- Rating -->
                            <% if(book.rating) { %>
                                <span class="book-card-rating"><i class="fa-solid fa-star"></i>
                                    <%= book.rating %>
                                </span>
                                <% } else { %>
                                    <span class="book-card-not-rated">Not rated</span>
                                    <% } %>

                                        <!-- Status -->
                                        <span class=" book-card-status"><i class="fa-solid fa-circle"> </i>
                                            <%= book.status %>
                                        </span>
                        </div>

                        <!-- Start and Completion dates -->
                        <div class="book-card-dates">

                            <!-- Start -->
                            <div class="book-card-start-date">
                                <span>Start:</span>
                                <strong>
                                    <% if(book.start_date) {%>
                                        <%= book.start_date.toLocaleDateString('en-US', { month: 'short' ,
                                            day: 'numeric' , year: 'numeric' }); %>
                                            <% } else { %>
                                                <div class="book-card-not-started">
                                                    Not started
                                                </div>
                                                <% } %>
                                </strong>
                            </div>

                            <!-- Completion -->
                            <div completion-date>
                                <span>Completion:</span>
                                <strong>
                                    <% if(book.completion_date) {%>
                                        <%= book.completion_date.toLocaleDateString('en-US',{ month: 'short' ,
                                            day: 'numeric' , year: 'numeric' }); %>
                                            <% } else { %>
                                                <div class="book-card-not-completed">
                                                    Not completed
                                                </div>
                                                <% } %>
                                </strong>
                            </div>
                        </div>

                        <!-- Note -->
                        <p class="book-card-note">
                            <% if(book.note) { %>
                                <% if(book.note.length> 120) { %>
                                    <%= book.note.slice(0, 120) %>…
                                        <% } else { %>
                                            <%= book.note %>
                                                <% } %>
                                                    <% } else { %>
                                                        <div class="book-card-no-note">No note added.</div>
                                                        <% } %>
                        </p>
                    </div>

                    <!-- Edit and Delete button -->
                    <div class="book-card-actions">
                        <!-- Edit -->
                        <a href="/books/<%= book.id %>/edit" class="book-card-edit-button"><i
                                class="fa-solid fa-pen-to-square"></i>
                        </a>

                        <!-- Delete -->
                        <form action="/books/<%= book.id %>/delete" method="post" class="book-card-remove-button">
                            <button type="submit"
                                onclick="return confirm('This action will completely delet this book. Are you sure want to delete the book?')"><i
                                    class="fa-solid fa-trash">
                                </i></button>
                        </form>
                    </div>

                </article>
                <% }); %>

        </div>

    </main>

    <!-- Footer section -->
    <%- include('partials/footer.ejs') %>