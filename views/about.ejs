<!-- Header section -->
<%- include('partials/header.ejs') %>

    <!-- Main section -->
    <main class="container about-page">

        <!-- Page header -->
        <div class="page-header">
            <h1>About Bookfolio</h1>
            <p>Your personal digital bookshelf.</p>
        </div>

        <!-- About Bookfolio -->
        <section class="about-section">
            <h2>What is Bookfolio?</h2>

            <p>
                Bookfolio is a personal digital bookshelf for keeping track
                of the books I read, my ratings, reading dates, and personal notes.
            </p>

            <p>
                It helps keep my reading journey organized in one place.
            </p>
        </section>

        <!-- Features -->
        <section class="about-section">
            <h2>Features</h2>

            <ul>
                <li>Add books to your library</li>
                <li>Rate books from 1 to 5</li>
                <li>Track reading status</li>
                <li>Record start and completion dates</li>
                <li>Write personal notes</li>
                <li>Search and sort your book collection</li>
            </ul>
        </section>

        <!-- Project -->
        <section class="about-section">
            <h2>About the project</h2>

            <p>
                Bookfolio is also a learning project where I am practicing
                how to build a full-stack web application using Node.js,
                Express, EJS, PostgreSQL, and external APIs.
            </p>

            <p>
                The project will continue to evolve as new features are
                added and the application becomes more complete.
            </p>
        </section>

    </main>

<!-- Footer section -->
<%- include('partials/footer.ejs') %>