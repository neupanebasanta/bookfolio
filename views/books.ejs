<!-- Header section -->
<%- include('partials/header.ejs') %>

    <!-- Main section -->
    <main class="container books-page">

        <!-- Page header -->
        <div class="page-header">
            <h1>My Books</h1>
            <p>View and manage your book shelves</p>
        </div>

        <!-- Books control panal -->
        <div class="books-controls">

            <!-- Search Bar Form -->
            <form action="/books" method="get" class="search-form">
                <input type="search" name="search_query" placeholder="Search books...">
                <button type="submit">Search</button>
            </form>

            <!-- Sort options Form -->
            <form action="/books" method="get" class="sort-form">
                <select name="sort_query" id="sort-menu">
                    <option value="recent">Recent</option>
                    <option value="rating">Rating</option>
                    <option value="a-z">A-Z</option>
                </select>
                <button type="submit">Sort</button>
            </form>
        </div>

        <!-- Books Grid -->
        <div class="books-grid">

            <!-- Book Card -->
            <% books.forEach(book=> { %>
                <article class="book-card">

                    <!-- Cover -->
                    <div class="book-cover">
                        <a href="/books/<%= book.id %>">
                            <% if (book.cover_url) { %>
                                <img src="<%= book.cover_url %>" alt="<%= book.title %>">
                                <% } else{ %>
                                    <h5>No cover</h5>
                                    <% } %>
                        </a>

                    </div>

                    <!-- Info -->
                    <div class="book-info">

                        <!-- Title -->
                        <a href="/books/<%= book.id %>" class="book-title">
                            <h2>
                                <%= book.title %>
                            </h2>
                        </a>

                        <!-- Author -->
                        <p class="book-author">
                            <%= book.author %>
                        </p>

                        <!-- Rating and Status -->
                        <div class="book-meta">
                            <!-- Rating -->
                            <% if(book.rating) { %>
                                <span>✯ <%= book.rating %></span>
                                <% } else { %>
                                    <span>Not rated</span>
                                    <% } %>

                                        <!-- Status -->
                                        <span>• <%= book.status %></span>
                        </div>

                        <!-- Start and Completion dates -->
                        <div class="book-dates">

                            <!-- Start -->
                            <div>
                                <span>Started:</span>
                                <strong>
                                    <% if(book.start_date) {%>
                                        <%= book.start_date.toLocaleDateString('en-US', { month: 'short' ,
                                            day: 'numeric' , year: 'numeric' }); %>
                                            <% } else { %>
                                                Not started
                                                <% } %>
                                </strong>
                            </div>

                            <!-- Completion -->
                            <div>
                                <span>Completed:</span>
                                <strong>

                                    <% if(book.completion_date) {%>
                                        <%= book.completion_date.toLocaleDateString('en-US',{ month: 'short' ,
                                            day: 'numeric' , year: 'numeric' }); %>
                                            <% } else { %>
                                                Not completed
                                                <% } %>
                                </strong>
                            </div>
                        </div>

                        <!-- Note -->
                        <p class="book-note">
                            <% if(book.note) { %>
                                <% if(book.note.length> 120) { %>
                                    <%= book.note.slice(0, 120) %>…
                                        <% } else { %>
                                            <%= book.note %>
                                                <% } %>
                                                    <% } else { %>
                                                        No note added.
                                                        <% } %>
                        </p>
                    </div>

                    <!-- Edit and Remove button -->
                    <div class="book-actions">
                        <!-- Edit -->
                        <a href="/books/<%= book.id %>/edit" class="edit-button">Edit</a>

                        <!-- Remove -->
                        <form action="/books/<%= book.id %>/remove" method="post" class="remove-button">
                            <button type="submit"
                                onclick="return confirm('This will remove the book completely. Are you sure want to remove the book?')">Remove</button>
                        </form>
                    </div>

                </article>
                <% }); %>

        </div>

    </main>

    <!-- Footer section -->
    <%- include('partials/footer.ejs') %>