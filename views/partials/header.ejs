<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bookfolio</title>
    <link rel="icon" href="/images/logo.svg" type="image/x-icon">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css">
</head>

<body>

    <!-- Page navebar -->
    <nav class="navbar">

        <!-- Logo -->
        <div class="navbar-logo">
            <a href="/" class="logo">
                <img src="/images/logo.svg" alt="logo">
                <span>Bookfolio</span>
            </a>
        </div>

        <!-- Links -->
        <div class=" navbar-links">
            <a href="/books" class="active">Home</a>
            <a href="/about">About</a>
        </div>

        <!-- Action Button -->
        <div class="navbar-action">
            <% if(currentPage==='/books' ) { %>
                <a href="/books/new"><i class="fa-solid fa-plus"></i>Add new</a>
                <% } else if(currentPage==='/books/new' ) { %>
                    <a href="/books"><i class="fa-solid fa-arrow-left"></i>To Books</a>
                    <% } else if(currentPage==='/about' ) {%>
                        <a href="/books"><i class="fa-solid fa-arrow-left"></i>To Books</a>
                        <% } else if(currentPage==='/books/id' ) { %>
                            <a href="/books"><i class="fa-solid fa-arrow-left"></i>To Books</a>
                            <% } %>
        </div>

    </nav>